[analysis]
detail = "deep"
max_file_bytes = 1000000
exclude = ["node_modules/**", "vendor/**", "dist/**", "build/**", "coverage/**"]

[model]
provider = "ollama"
name = "gemma4:e4b"
base_url = "http://127.0.0.1:11434"
timeout_seconds = 120

[security]
offline = true
persist_model_cache = false

[output]
path = "docs/codebase"
diagrams = ["technical", "dataflow", "c4", "runtime", "visual"]
